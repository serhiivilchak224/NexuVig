@page "/equipamento/{AgentId}"
@inject HttpClient Http
@using NexuVig.Shared
@implements IDisposable

<PageTitle>NexuVig - @(pc?.Nome ?? "Equipamento")</PageTitle>

<div class="container-fluid mt-4">
    <a href="/" class="btn btn-sm btn-outline-secondary mb-3">← Voltar ao painel</a>

    @if (aCarregar)
    {
        <p class="text-muted">A carregar...</p>
    }
    else if (pc == null)
    {
        <div class="alert alert-warning">Equipamento não encontrado.</div>
    }
    else
    {
        var online = (DateTimeOffset.UtcNow - pc.DataHora).TotalSeconds < 90;
        var discoLivrePct = pc.DiscoTotalGiB > 0 ? (pc.DiscoLivreGiB / pc.DiscoTotalGiB) * 100 : 100;
        var tempoLigado = TimeSpan.FromSeconds(pc.TempoLigadoSegundos);

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="display-6">@pc.Nome</h1>
            @if (online)
            {
                <span class="badge bg-success fs-6">Online</span>
            }
            else
            {
                <span class="badge bg-danger fs-6">Sem comunicação</span>
            }
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted">CPU</h6>
                        <h2 class="@(pc.UtilizacaoCPU > 90 ? "text-danger" : "")">@pc.UtilizacaoCPU.ToString("F0")%</h2>
                        <small class="text-muted">@pc.Processador</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted">RAM</h6>
                        <h2 class="@(pc.UtilizacaoRAM > 90 ? "text-danger" : "")">@pc.UtilizacaoRAM.ToString("F0")%</h2>
                        <small class="text-muted">
                            @pc.MemoriaDisponivelGiB.ToString("F1") GiB livres de @pc.MemoriaTotalGiB.ToString("F1") GiB
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted">Disco livre</h6>
                        <h2 class="@(discoLivrePct < 15 ? "text-danger" : "")">@discoLivrePct.ToString("F1")%</h2>
                        <small class="text-muted">
                            @pc.DiscoLivreGiB.ToString("F1") GiB livres de @pc.DiscoTotalGiB.ToString("F1") GiB
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">Informação do equipamento</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Sistema operativo</span><span>@pc.SistemaOperativo</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Processador</span><span>@pc.Processador</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Tempo ligado</span>
                    <span>@((int)tempoLigado.TotalDays)d @tempoLigado.Hours h @tempoLigado.Minutes min</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Última comunicação</span>
                    <span>@pc.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Identificador do Agent</span><span class="font-monospace">@pc.AgentId</span>
                </li>
            </ul>
        </div>

        @if (pc.UtilizacaoCPU > 90 || pc.UtilizacaoRAM > 90 || discoLivrePct < 15)
        {
            <div class="alert alert-danger">
                <strong>Alertas ativos:</strong>
                @if (pc.UtilizacaoCPU > 90) { <span class="badge bg-danger me-1">CPU alta</span> }
                @if (pc.UtilizacaoRAM > 90) { <span class="badge bg-danger me-1">RAM alta</span> }
                @if (discoLivrePct < 15) { <span class="badge bg-warning text-dark">Disco cheio</span> }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string AgentId { get; set; } = "";

    private DadosEquipamento? pc;
    private bool aCarregar = true;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
        aCarregar = false;

        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await CarregarDados();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task CarregarDados()
    {
        try
        {
            var lista = await Http.GetFromJsonAsync<List<DadosEquipamento>>("/api/medicoes");
            pc = lista?.FirstOrDefault(e => e.AgentId == AgentId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro: {ex.Message}");
        }
    }

    public void Dispose() => _timer?.Dispose();
}
