@page "/"
@inject HttpClient Http
@using NexuVig.Shared
@implements IDisposable

<PageTitle>NexuVig - Painel</PageTitle>

<div class="nv-cabecalho">
    <div>
        <h1 class="nv-titulo">Painel de monitorização</h1>
        <div class="nv-subtitulo">
            @if (ultimaAtualizacao is null)
            {
                <span>A carregar dados...</span>
            }
            else
            {
                <span>Atualizado às @ultimaAtualizacao.Value.ToLocalTime().ToString("HH:mm:ss") · atualiza sozinho a cada @SegundosEntreAtualizacoes s</span>
            }
        </div>
    </div>

    <div class="nv-acoes">
        @if (servidorOnline is null)
        {
            <span class="nv-pilula nv-neutro">A ligar ao servidor</span>
        }
        else if (servidorOnline == true)
        {
            <span class="nv-pilula nv-ok">Servidor online</span>
        }
        else
        {
            <span class="nv-pilula nv-perigo" title="O Dashboard não conseguiu contactar o Server.">Servidor offline</span>
        }

        <button class="nv-botao" @onclick="ForcarAtualizacao">
            <i class="bi bi-arrow-clockwise @(aAtualizar ? "nv-gira" : "")" aria-hidden="true"></i>
            @(aAtualizar ? "A atualizar..." : "Atualizar")
        </button>
    </div>
</div>

<div class="nv-resumo">
    <div class="nv-cartao nv-numero">
        <div class="nv-numero-titulo">
            <span class="nv-numero-icone" style="color: var(--nv-acento); background: var(--nv-acento-suave);"><i class="bi bi-pc-display" aria-hidden="true"></i></span>
            Equipamentos
        </div>
        <div class="nv-numero-valor">@equipamentos.Count</div>
    </div>
    <div class="nv-cartao nv-numero">
        <div class="nv-numero-titulo">
            <span class="nv-numero-icone nv-ok"><i class="bi bi-wifi" aria-hidden="true"></i></span>
            Online
        </div>
        <div class="nv-numero-valor">@equipamentos.Count(Monitorizacao.EstaOnline)</div>
    </div>
    <div class="nv-cartao nv-numero">
        <div class="nv-numero-titulo">
            <span class="nv-numero-icone nv-perigo"><i class="bi bi-wifi-off" aria-hidden="true"></i></span>
            Sem comunicação
        </div>
        <div class="nv-numero-valor">@equipamentos.Count(e => !Monitorizacao.EstaOnline(e))</div>
    </div>
    <div class="nv-cartao nv-numero">
        <div class="nv-numero-titulo">
            <span class="nv-numero-icone nv-aviso"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
            Alertas ativos
        </div>
        <div class="nv-numero-valor">@equipamentos.Count(Monitorizacao.TemAlerta)</div>
    </div>
</div>

<div class="nv-cartao">
    <div class="nv-cartao-cabecalho">
        <span>Equipamentos</span>
        <span class="nv-subtitulo" style="margin: 0; font-weight: 400;">@equipamentos.Count no total</span>
    </div>

    @if (equipamentos.Count == 0)
    {
        <div class="nv-vazio">
            <i class="bi bi-pc-display" aria-hidden="true"></i>
            @if (servidorOnline == false)
            {
                <div>Não foi possível contactar o Server. Confirma que está a correr.</div>
            }
            else
            {
                <div>Ainda não há equipamentos. Aparecem aqui depois da primeira medição do Agent.</div>
            }
        </div>
    }
    else
    {
        <div class="nv-tabela-scroll">
            <table class="nv-tabela">
                <thead>
                    <tr>
                        <th>Equipamento</th>
                        <th>Estado</th>
                        <th>CPU</th>
                        <th>RAM</th>
                        <th>Disco livre</th>
                        <th>Alertas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pc in EquipamentosOrdenados)
                    {
                        var online = Monitorizacao.EstaOnline(pc);
                        var discoLivre = Monitorizacao.PercentagemDiscoLivre(pc);
                        var ip = Monitorizacao.IpPrincipal(pc);

                        <tr class="@(online ? "" : "nv-desligado")">
                            <td>
                                <a class="nv-nome" href="/equipamento/@pc.AgentId">@pc.Nome</a>
                                <div class="nv-detalhe">
                                    @(ip ?? "sem IP") · @Monitorizacao.TempoDesde(pc.DataHora)
                                </div>
                            </td>
                            <td>
                                <span class="nv-pilula @(online ? "nv-ok" : "nv-perigo")">@(online ? "Online" : "Offline")</span>
                            </td>
                            <td>
                                <BarraUso Percentagem="pc.UtilizacaoCPU" />
                            </td>
                            <td>
                                <BarraUso Percentagem="pc.UtilizacaoRAM" />
                            </td>
                            <td>
                                <BarraUso Percentagem="100 - discoLivre" Texto="@($"{discoLivre:F1}%")" />
                            </td>
                            <td>
                                @if (Monitorizacao.CpuAlta(pc)) { <span class="nv-etiqueta nv-perigo">CPU alta</span> }
                                @if (Monitorizacao.RamAlta(pc)) { <span class="nv-etiqueta nv-perigo">RAM alta</span> }
                                @if (Monitorizacao.DiscoCheio(pc)) { <span class="nv-etiqueta nv-aviso">Disco cheio</span> }
                                @if (!Monitorizacao.TemAlerta(pc)) { <span class="nv-detalhe">—</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private const int SegundosEntreAtualizacoes = 5;

    private List<DadosEquipamento> equipamentos = new();
    private bool? servidorOnline;
    private DateTimeOffset? ultimaAtualizacao;
    private bool aAtualizar;
    private System.Threading.Timer? temporizador;

    // Online primeiro, depois por nome.
    private IEnumerable<DadosEquipamento> EquipamentosOrdenados =>
        equipamentos.OrderByDescending(Monitorizacao.EstaOnline).ThenBy(e => e.Nome);

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();

        temporizador = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await CarregarDados();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(SegundosEntreAtualizacoes), TimeSpan.FromSeconds(SegundosEntreAtualizacoes));
    }

    private async Task CarregarDados()
    {
        try
        {
            var resposta = await Http.GetFromJsonAsync<List<DadosEquipamento>>("/api/medicoes");
            equipamentos = resposta ?? new();
            servidorOnline = true;
            ultimaAtualizacao = DateTimeOffset.UtcNow;
        }
        catch (Exception erro)
        {
            // Mantém os últimos dados no ecrã e mostra que o Server não respondeu.
            servidorOnline = false;
            Console.WriteLine($"Erro ao contactar o Server: {erro.Message}");
        }
    }

    private async Task ForcarAtualizacao()
    {
        if (aAtualizar) return;

        aAtualizar = true;
        StateHasChanged();

        // Pequena espera para o utilizador ver que o botão reagiu.
        await Task.WhenAll(CarregarDados(), Task.Delay(400));

        aAtualizar = false;
    }

    public void Dispose() => temporizador?.Dispose();
}
