@inject IJSRuntime JS

<div class="nv-nav">
    <a class="nv-marca" href="">
        <i class="bi bi-radar" aria-hidden="true"></i>
        <span>NexuVig</span>
    </a>

    <nav class="nv-links">
        <NavLink class="nv-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i> Painel
        </NavLink>
    </nav>

    <button class="nv-link nv-tema" @onclick="MudarTema">
        <i class="bi @(temaEscuro ? "bi-sun" : "bi-moon-stars")" aria-hidden="true"></i>
        @(temaEscuro ? "Tema claro" : "Tema escuro")
    </button>
</div>

@code {
    private bool temaEscuro = true;

    protected override async Task OnAfterRenderAsync(bool primeiraVez)
    {
        if (primeiraVez)
        {
            temaEscuro = await JS.InvokeAsync<string>("nexuvigTema.obter") == "dark";
            StateHasChanged();
        }
    }

    private async Task MudarTema()
    {
        temaEscuro = await JS.InvokeAsync<string>("nexuvigTema.alternar") == "dark";
    }
}
