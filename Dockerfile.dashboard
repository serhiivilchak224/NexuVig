# NexuVig.Dashboard para alojamento online (Render). Contexto de build: raiz do repositório.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY nex/NexuVig.Agent/NexuVig.Shared/ nex/NexuVig.Agent/NexuVig.Shared/
COPY NexuVig.Dashboard/ NexuVig.Dashboard/
RUN dotnet publish NexuVig.Dashboard/NexuVig.Dashboard.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
# O Render define PORT; o Dashboard ouve nessa porta (ver Program.cs).
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
ENTRYPOINT ["dotnet", "NexuVig.Dashboard.dll"]
